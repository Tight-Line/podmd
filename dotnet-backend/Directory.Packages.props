<Project>
  <PropertyGroup>
    <ManagePackageVersionCentrally>true</ManagePackageVersionCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- ASP.NET Core -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="[9.0.0, 10.0.0)" />
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="[6.6.2, 7.0.0)" />

    <!-- Entity Framework Core -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="[9.0.0, 10.0.0)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="[9.0.0, 10.0.0)" />
    <PackageVersion Include="Pomelo.EntityFrameworkCore.MySql" Version="[9.0.0, 10.0.0)" />

    <!-- Identity -->
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="[9.0.0, 10.0.0)" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="[9.0.0, 10.0.0)" />

    <!-- Health Checks -->
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="[9.0.0, 10.0.0)" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="[9.0.0, 10.0.0)" />

    <!-- Logging -->
    <PackageVersion Include="Serilog.AspNetCore" Version="[8.0.1, 9.0.0)" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="[5.0.1, 6.0.0)" />

    <!-- Testing (when added later) -->
    <PackageVersion Include="xunit" Version="[2.9.0, 3.0.0)" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="[9.0.0, 10.0.0)" />
  </ItemGroup>
</Project>
