{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "Database": {
    "ConnectionString": "Server=localhost;Port=3306;Database=PodMD;User=root;Password=password;",
    "MaxRetryCount": 5,
    "MaxRetryDelay": "00:00:30"
  },
  "Jwt": {
    "Secret": "super-secret-jwt-key-here-change-this-in-production",
    "Issuer": "PodMD",
    "Audience": "PodMDUsers",
    "ExpiryMinutes": 60
  },
  "Encryption": {
    "Key": "super-secret-encryption-key-here-change-this-in-production",
    "KeyVersion": 1
  },
  "LLM": {
    "ApiKey": "your-openai-api-key-here",
    "BaseUrl": "https://api.openai.com/v1/",
    "Model": "gpt-3.5-turbo",
    "MaxRetries": 3,
    "TimeoutSeconds": 30,
    "MaxTokens": 1500,
    "Temperature": 0.1
  },
  "AllowedHosts": "*"
}
