# PodMD Python Backend Environment Configuration Template
# Copy this file to .env and fill in your actual values

# Application Settings
APP_NAME=podmd-python-backend
APP_ENV=development
APP_DEBUG=true

# Server Settings
HOST=0.0.0.0
PORT=8081

# Database Settings (PostgreSQL)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=podmd_db
POSTGRES_USER=podmd_user
POSTGRES_PASSWORD=your_strong_password_here

# Database URL (alternative format for some libraries)
DATABASE_URL=postgresql://podmd_user:your_strong_password_here@postgres:5432/podmd_db

# Logging Settings
LOG_LEVEL=INFO
LOG_FORMAT=json

# CORS Settings (for future frontend integration)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Security Settings (future use)
SECRET_KEY=your-secret-key-here-change-in-production
JWT_SECRET_KEY=your-jwt-secret-here-change-in-production

# LLM Integration (future use)
OPENAI_API_KEY=your-openai-api-key-here
